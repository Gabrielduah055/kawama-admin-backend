{
  "info": {
    "name": "Kawama API",
    "description": "Local API checks for the Kawama storefront and owner administration. Run Admin Login first; its test script stores the JWT in the collection automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{adminToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminLogin", "value": "kawamagh.gmail.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "checkoutProductId", "value": "" },
    { "key": "checkoutToken", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "chatConversationId", "value": "" },
    { "key": "chatSessionToken", "value": "" }
  ],
  "item": [
    {
      "name": "System and authentication",
      "item": [
        {
          "name": "Database readiness",
          "auth": { "type": "noauth" },
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        },
        {
          "name": "Admin Login",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "if (payload.data?.token) pm.collectionVariables.set('adminToken', payload.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminLogin}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/login"
          }
        },
        {
          "name": "OpenAPI contract",
          "auth": { "type": "noauth" },
          "request": { "method": "GET", "url": "{{baseUrl}}/openapi.json" }
        }
      ]
    },
    {
      "name": "Public storefront",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "List active categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/product/categories" }
        },
        {
          "name": "List active products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/product?page=1&limit=24" }
        },
        {
          "name": "Start shopping chat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Shopping assistant responds', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "if (payload.data?.conversationId) pm.collectionVariables.set('chatConversationId', payload.data.conversationId);",
                  "const session = pm.response.headers.get('X-Chat-Session');",
                  "if (session) pm.collectionVariables.set('chatSessionToken', session);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"I need a blender under 400 cedis\"\n}" },
            "url": "{{baseUrl}}/api/ai/chat"
          }
        },
        {
          "name": "Continue shopping chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Chat-Session", "value": "{{chatSessionToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"conversationId\": \"{{chatConversationId}}\",\n  \"message\": \"Show me a cheaper one.\"\n}" },
            "url": "{{baseUrl}}/api/ai/chat"
          }
        }
      ]
    },
    {
      "name": "Paystack checkout",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Initialize checkout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('checkoutToken', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Paystack checkout initialized', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const payload = pm.response.json();",
                  "pm.test('Access code returned', () => pm.expect(payload.data?.payment?.accessCode).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{checkoutToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"fullName\": \"Postman Customer\",\n    \"email\": \"customer@example.com\",\n    \"whatsappNumber\": \"+233241234567\",\n    \"deliveryAddress\": \"Accra, Ghana\",\n    \"whatsappConsent\": true\n  },\n  \"orderNotes\": \"Test-mode checkout\",\n  \"items\": [\n    {\n      \"productId\": \"{{checkoutProductId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/checkout/sessions"
          }
        },
        {
          "name": "Get checkout status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/checkout/sessions/{{checkoutToken}}"
          }
        }
      ]
    },
    {
      "name": "Admin commerce",
      "item": [
        {
          "name": "Dashboard summary",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/dashboard/summary" }
        },
        {
          "name": "List orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Orders listed', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "if (payload.data?.[0]?.id) pm.collectionVariables.set('orderId', payload.data[0].id);"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/orders?page=1&limit=24" }
        },
        {
          "name": "Get order",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}" }
        },
        {
          "name": "Update fulfillment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"processing\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}/fulfillment"
          }
        },
        {
          "name": "Quote delivery fee",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"deliveryFeeStatus\": \"quoted\",\n  \"deliveryFee\": 35.5\n}" },
            "url": "{{baseUrl}}/api/v1/admin/orders/{{orderId}}/delivery"
          }
        },
        {
          "name": "List customers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customers listed', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "if (payload.data?.[0]?.id) pm.collectionVariables.set('customerId', payload.data[0].id);"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/customers?page=1&limit=24" }
        },
        {
          "name": "Get customer",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/customers/{{customerId}}" }
        }
      ]
    },
    {
      "name": "Admin categories",
      "item": [
        {
          "name": "List categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/categories" }
        },
        {
          "name": "Create test category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Category created', () => pm.response.to.have.status(201));",
                  "const payload = pm.response.json();",
                  "if (payload.data?.id) pm.collectionVariables.set('categoryId', payload.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Category\",\n  \"slug\": \"postman-test-category\",\n  \"description\": \"A temporary category created from Postman.\",\n  \"displayOrder\": 99\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/categories"
          }
        },
        {
          "name": "Update test category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated from Postman.\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}"
          }
        },
        {
          "name": "Archive test category",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}" }
        },
        {
          "name": "Restore test category",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}/restore" }
        }
      ]
    },
    {
      "name": "Admin products",
      "item": [
        {
          "name": "List products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/products?page=1&limit=24" }
        },
        {
          "name": "Create draft product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Product created', () => pm.response.to.have.status(201));",
                  "const payload = pm.response.json();",
                  "if (payload.data?.id) pm.collectionVariables.set('productId', payload.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"postman-test-product\",\n  \"name\": \"Postman Test Product\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"price\": 125.5,\n  \"stockQuantity\": 5,\n  \"status\": \"draft\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/products"
          }
        },
        {
          "name": "Get product",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}" }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stockQuantity\": 10,\n  \"featured\": true\n}" },
            "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}"
          }
        },
        {
          "name": "Archive product",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}" }
        },
        {
          "name": "Restore product as draft",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}/restore" }
        }
      ]
    },
    {
      "name": "Admin reviews and uploads",
      "item": [
        {
          "name": "List pending reviews",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/reviews?status=pending&page=1&limit=24" }
        },
        {
          "name": "Create Cloudinary upload signature",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/admin/uploads/signature" }
        }
      ]
    }
  ]
}
