NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.example/kawama
# Optional Windows/local fallback when the default resolver refuses Atlas SRV lookups.
MONGODB_DNS_SERVERS=
FRONTEND_ORIGINS=http://localhost:4200
LOG_LEVEL=info

ADMIN_EMAIL=admin-login
ADMIN_PASSWORD=choose-a-strong-bootstrap-password
JWT_SECRET=generate-at-least-32-random-characters
JWT_EXPIRES_IN=43200

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kawama

# Required for checkout: paste your actual sk_test_... key from the Paystack test dashboard.
# Leave this blank until you have a real key. Example/placeholder and pk_... values are rejected.
# This secret is server-only; never put it in Angular source, logs, or API responses.
PAYSTACK_SECRET_KEY=
# Paystack's actual API origin. The backend appends /transaction/initialize and /transaction/verify/:reference.
PAYSTACK_BASE_URL=https://api.paystack.co
# Frontend route where Paystack returns the browser after a test payment.
PAYSTACK_CALLBACK_URL=http://localhost:4200/checkout/result
# Configure this webhook in the Paystack test dashboard for the deployed test API:
# https://kawama-admin-backend.onrender.com/api/v1/webhooks/paystack
# For a local backend, use an HTTPS tunnel because Paystack cannot call localhost.
# The Angular local API base URL is http://localhost:3000/api/v1 (configured in the Angular repository).

# AI shopping assistant. The API key is server-only and must never be exposed to Angular.
# Set AI_CHAT_ENABLED=false to disable POST /api/ai/chat without affecting catalog or checkout routes.
AI_CHAT_ENABLED=true
OPENROUTER_API_KEY=
# Default shown below; set a different OpenRouter model ID only as an explicit server configuration choice.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_MS=30000
AI_CHAT_CONVERSATION_TTL_HOURS=24

# Server-only high-entropy key shared with OrderBridge. Generate at least 32 characters.
ORDERBRIDGE_API_KEY=

# Optional canonical product link. Keep the literal {slug}; unset means product cards omit url.
# OrderBridge product endpoints require this to be an HTTPS storefront URL.
STOREFRONT_PRODUCT_URL_TEMPLATE=

# Approved store information exposed by the chatbot. Blank values are reported as not configured.
STORE_CONTACT_EMAIL=
STORE_CONTACT_PHONE=
STORE_CONTACT_WHATSAPP_URL=
STORE_DELIVERY_POLICY=
STORE_PAYMENT_POLICY=
STORE_RETURN_POLICY=

SEED_ASSET_DIR=../kawama/public/images
# Optional immutable/public URL prefix for bundled seed images. When omitted, the seed uploads to Cloudinary.
SEED_ASSET_BASE_URL=
