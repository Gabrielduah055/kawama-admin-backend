NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.example/kawama
# Optional Windows/local fallback when the default resolver refuses Atlas SRV lookups.
MONGODB_DNS_SERVERS=
FRONTEND_ORIGINS=http://localhost:4200
LOG_LEVEL=info

ADMIN_EMAIL=admin-login
ADMIN_PASSWORD=choose-a-strong-bootstrap-password
JWT_SECRET=generate-at-least-32-random-characters
JWT_EXPIRES_IN=43200

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kawama

SEED_ASSET_DIR=../kawama/public/images
# Optional immutable/public URL prefix for bundled seed images. When omitted, the seed uploads to Cloudinary.
SEED_ASSET_BASE_URL=
